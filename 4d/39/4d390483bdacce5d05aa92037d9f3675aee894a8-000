  const el = document.getElementById("opticalSizesContainer");
  const rows = [
    { label: "Corps / Micro (Newsreader 9pt vs Source Serif 4 Base)", newsCut: "9pt", srcCut: "base" },
    { label: "Lecture courante (Newsreader 14pt vs Source Serif 4 18pt)", newsCut: "14pt", srcCut: "18pt" },
    { label: "Sous-titres (Newsreader 24pt vs Source Serif 4 18pt)", newsCut: "24pt", srcCut: "18pt" },
    { label: "Titres (Newsreader 36pt vs Source Serif 4 36pt)", newsCut: "36pt", srcCut: "36pt" },
