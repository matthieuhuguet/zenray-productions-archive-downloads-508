  ];

  el.innerHTML = rows.map(r => {
    return `<div class="weight-band">
      <div class="weight-band-header">
        <div class="weight-title">
          <span class="weight-num">opsz</span>
          <span class="weight-name">${r.label}</span>
        </div>
        <span class="weight-status">Comparaison du contraste des déliés et de l'écartement</span>
      </div>
      <div class="tri-grid">
        <div class="cell-specimen">
          <div class="cell-top-meta"><span>Anthropic Serif · Regular 400</span><span>AnthropicSerif-Regular.ttf (coupe unique)</span></div>
          <div class="spec-headline" style="font-family: 'zr_anth_400_rom', serif;">${escapeHtml(state.headlineSample)}</div>
          <div class="spec-body" style="font-family: 'zr_anth_400_rom', serif;">${escapeHtml(state.bodySample)}</div>
        </div>
        <div class="cell-specimen">
          <div class="cell-top-meta"><span>Newsreader ${r.newsCut} · Regular 400</span><span>Newsreader_${r.newsCut}-Regular.ttf</span></div>
          <div class="spec-headline" style="font-family: 'zr_news_${r.newsCut}_400_rom', serif;">${escapeHtml(state.headlineSample)}</div>
          <div class="spec-body" style="font-family: 'zr_news_${r.newsCut}_400_rom', serif;">${escapeHtml(state.bodySample)}</div>
        </div>
        <div class="cell-specimen">
          <div class="cell-top-meta"><span>Source Serif 4 (${r.srcCut}) · Regular 400</span><span>SourceSerif4${r.srcCut === "base" ? "" : "_" + r.srcCut}-Regular.ttf</span></div>
          <div class="spec-headline" style="font-family: 'zr_src4_${r.srcCut}_400_rom', serif;">${escapeHtml(state.headlineSample)}</div>
