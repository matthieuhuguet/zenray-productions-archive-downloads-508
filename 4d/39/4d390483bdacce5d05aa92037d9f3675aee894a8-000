<!-- BARRE HDA PARAMETRIQUE -->
<header class="hda-panel" id="hdaPanel">
  <div class="hda-header">
    <div class="hda-title-group">
      <span class="hda-badge">HDA V_001 · 12 October 2026</span>
      <h1 class="hda-title">Comparatif Typographique : Anthropic Serif vs Newsreader vs Source Serif <span class="num-serif">4</span></h1>
    </div>
    <div class="hda-actions">
      <button class="hda-btn" id="btnTogglePanel" type="button">Masquer / Afficher les curseurs</button>
      <button class="hda-btn" id="btnReset" type="button">Réinitialiser (défauts V_001)</button>
      <button class="hda-btn primary" id="btnCopyPrompt" type="button">Copier les valeurs pour le prompt</button>
    </div>
  </div>

  <div class="hda-controls-body">
    <!-- Categorie 1 : Echelle & Geometrie (8 parametres) -->
    <div class="hda-controls-grid" style="margin-bottom: 10px;">
      <div class="ctrl-item">
        <div class="ctrl-label"><span>1. Taille Titre (Display)</span><span class="ctrl-val" id="valDisplay">42 px</span></div>
        <input type="range" id="rngDisplay" min="22" max="84" step="1" value="42">
      </div>
      <div class="ctrl-item">
        <div class="ctrl-label"><span>2. Taille Spécimen Graisses</span><span class="ctrl-val" id="valSpecimen">28 px</span></div>
        <input type="range" id="rngSpecimen" min="16" max="56" step="1" value="28">
      </div>
      <div class="ctrl-item">
        <div class="ctrl-label"><span>3. Taille Chapô (Lead)</span><span class="ctrl-val" id="valLead">21 px</span></div>
        <input type="range" id="rngLead" min="14" max="36" step="1" value="21">
      </div>
      <div class="ctrl-item">
        <div class="ctrl-label"><span>4. Taille Corps (Body)</span><span class="ctrl-val" id="valBody">17 px</span></div>
        <input type="range" id="rngBody" min="12" max="28" step="0.5" value="17">
      </div>
      <div class="ctrl-item">
        <div class="ctrl-label"><span>5. Interligne Corps</span><span class="ctrl-val" id="valLh">1.55</span></div>
        <input type="range" id="rngLh" min="1.15" max="2.00" step="0.05" value="1.55">
      </div>
      <div class="ctrl-item">
        <div class="ctrl-label"><span>6. Approche Titre (em)</span><span class="ctrl-val" id="valLs">-0.015 em</span></div>
        <input type="range" id="rngLs" min="-0.05" max="0.06" step="0.005" value="-0.015">
      </div>
      <div class="ctrl-item">
        <div class="ctrl-label"><span>7. Axe optique Variable (opsz)</span><span class="ctrl-val" id="valOpsz">18 pt</span></div>
        <input type="range" id="rngOpsz" min="8" max="60" step="1" value="18">
      </div>
      <div class="ctrl-item">
        <div class="ctrl-label"><span>8. Graisse Variable libre (wght)</span><span class="ctrl-val" id="valWght">350</span></div>
        <input type="range" id="rngWght" min="200" max="900" step="10" value="350">
      </div>
