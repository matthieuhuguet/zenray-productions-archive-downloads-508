        </div>
      </div>
    </div>`;
  }).join("");
}

function measureMetrics() {
  const pAnth = document.getElementById("probeAnth");
  const pNews = document.getElementById("probeNews");
  const pSrc4 = document.getElementById("probeSrc4");

  const sz = state.sizeBody + "px";
  pAnth.style.fontSize = sz;
  pNews.style.fontSize = sz;
  pSrc4.style.fontSize = sz;

  pAnth.style.fontFamily = "'zr_anth_400_rom', serif";
  pNews.style.fontFamily = `'zr_news_${state.newsOpsz}_400_rom', serif`;
  pSrc4.style.fontFamily = `'zr_src4_${state.srcOpsz}_400_rom', serif`;

  const wAnth = pAnth.getBoundingClientRect().width;
  const wNews = pNews.getBoundingClientRect().width;
  const wSrc4 = pSrc4.getBoundingClientRect().width;

  if (wAnth > 0) {
    document.getElementById("mWidthAnth").textContent = Math.round(wAnth) + " px";
    document.getElementById("mWidthNews").textContent = Math.round(wNews) + " px";
    document.getElementById("mWidthSrc4").textContent = Math.round(wSrc4) + " px";
    document.getElementById("mRatioNews").textContent = Math.round((wNews / wAnth) * 100) + "%";
    document.getElementById("mRatioSrc4").textContent = Math.round((wSrc4 / wAnth) * 100) + "%";
  }

  // Mesure exacte sur canvas de la hauteur de 'x' a 100px
  const canvas = document.createElement("canvas");
  canvas.width = 200;
  canvas.height = 200;
  const ctx = canvas.getContext("2d");

  function measureGlyphHeight(fontFamily) {
    ctx.font = `400 100px ${fontFamily}`;
    const m = ctx.measureText("x");
    if (m.actualBoundingBoxAscent !== undefined) {
      return (m.actualBoundingBoxAscent + m.actualBoundingBoxDescent).toFixed(1) + "%";
    }
    return "n/a";
  }

  document.getElementById("mXhAnth").textContent = measureGlyphHeight("'zr_anth_400_rom'");
  document.getElementById("mXhNews").textContent = measureGlyphHeight(`'zr_news_${state.newsOpsz}_400_rom'`);
  document.getElementById("mXhSrc4").textContent = measureGlyphHeight(`'zr_src4_${state.srcOpsz}_400_rom'`);
}

function applyCssVars() {
  const root = document.documentElement;
  root.style.setProperty("--hda-size-display", state.sizeDisplay + "px");
  root.style.setProperty("--hda-size-specimen", state.sizeSpecimen + "px");
  root.style.setProperty("--hda-size-lead", state.sizeLead + "px");
  root.style.setProperty("--hda-size-body", state.sizeBody + "px");
  root.style.setProperty("--hda-lh-body", state.lhBody);
  root.style.setProperty("--hda-ls-display", state.lsDisplay + "em");
  root.style.setProperty("--hda-opsz", state.opsz);
  root.style.setProperty("--hda-custom-wght", state.customWght);

  document.body.setAttribute("data-theme", state.theme);
  document.body.setAttribute("data-guides", String(state.guides));

  document.getElementById("valDisplay").textContent = state.sizeDisplay + " px";
  document.getElementById("valSpecimen").textContent = state.sizeSpecimen + " px";
  document.getElementById("valLead").textContent = state.sizeLead + " px";
  document.getElementById("valBody").textContent = state.sizeBody + " px";
  document.getElementById("valLh").textContent = state.lhBody;
  document.getElementById("valLs").textContent = state.lsDisplay + " em";
  document.getElementById("valOpsz").textContent = state.opsz + " pt";
  document.getElementById("valWght").textContent = state.customWght;
  document.getElementById("lblCurrentBody").textContent = state.sizeBody;
  document.querySelectorAll('[data-bind="bodyPx"]').forEach(el => { el.textContent = state.sizeBody; });
}

function fullRender() {
  applyCssVars();
  renderEditorialCards();
  renderWeightsSection();
  renderOpticalSizesSection();
  measureMetrics();
}

// Branchement des controles HDA
document.getElementById("rngDisplay").addEventListener("input", e => { state.sizeDisplay = Number(e.target.value); applyCssVars(); });
document.getElementById("rngSpecimen").addEventListener("input", e => { state.sizeSpecimen = Number(e.target.value); applyCssVars(); });
document.getElementById("rngLead").addEventListener("input", e => { state.sizeLead = Number(e.target.value); applyCssVars(); });
document.getElementById("rngBody").addEventListener("input", e => { state.sizeBody = Number(e.target.value); applyCssVars(); measureMetrics(); });
document.getElementById("rngLh").addEventListener("input", e => { state.lhBody = Number(e.target.value); applyCssVars(); });
document.getElementById("rngLs").addEventListener("input", e => { state.lsDisplay = Number(e.target.value); applyCssVars(); });
document.getElementById("rngOpsz").addEventListener("input", e => { state.opsz = Number(e.target.value); fullRender(); });
document.getElementById("rngWght").addEventListener("input", e => { state.customWght = Number(e.target.value); fullRender(); });

document.getElementById("selTheme").addEventListener("change", e => { state.theme = e.target.value; applyCssVars(); });
document.getElementById("selRenderMode").addEventListener("change", e => { state.renderMode = e.target.value; fullRender(); });
document.getElementById("selNewsOpsz").addEventListener("change", e => { state.newsOpsz = e.target.value; fullRender(); });
document.getElementById("selSrcOpsz").addEventListener("change", e => { state.srcOpsz = e.target.value; fullRender(); });
document.getElementById("selStyleFilter").addEventListener("change", e => { state.styleFilter = e.target.value; renderWeightsSection(); });
document.getElementById("selGuides").addEventListener("change", e => { state.guides = e.target.value === "true"; applyCssVars(); });
document.getElementById("inpHeadline").addEventListener("input", e => {
  state.headlineSample = e.target.value;
  renderEditorialCards();
  renderWeightsSection();
  renderOpticalSizesSection();
});

document.getElementById("btnTogglePanel").addEventListener("click", () => {
  document.getElementById("hdaPanel").classList.toggle("hda-Details-closed");
});

document.getElementById("btnReset").addEventListener("click", () => {
  Object.assign(state, {
    sizeDisplay: DEFAULTS.scale_and_geometry.size_display_px,
    sizeSpecimen: DEFAULTS.scale_and_geometry.size_specimen_px,
    sizeLead: DEFAULTS.scale_and_geometry.size_lead_px,
    sizeBody: DEFAULTS.scale_and_geometry.size_body_px,
    lhBody: DEFAULTS.scale_and_geometry.line_height_body,
    lsDisplay: DEFAULTS.scale_and_geometry.letter_spacing_display_em,
    opsz: DEFAULTS.scale_and_geometry.variable_opsz,
    customWght: DEFAULTS.scale_and_geometry.variable_custom_wght,
    theme: DEFAULTS.display_and_theme.theme,
    renderMode: DEFAULTS.display_and_theme.render_mode,
    newsOpsz: DEFAULTS.display_and_theme.newsreader_optical_cut,
    srcOpsz: DEFAULTS.display_and_theme.sourceserif_optical_cut,
    styleFilter: DEFAULTS.display_and_theme.style_filter,
    guides: DEFAULTS.display_and_theme.show_metrics_guides,
    headlineSample: DEFAULTS.display_and_theme.headline_sample,
    bodySample: DEFAULTS.display_and_theme.body_sample
  });
  document.getElementById("rngDisplay").value = state.sizeDisplay;
  document.getElementById("rngSpecimen").value = state.sizeSpecimen;
  document.getElementById("rngLead").value = state.sizeLead;
  document.getElementById("rngBody").value = state.sizeBody;
  document.getElementById("rngLh").value = state.lhBody;
  document.getElementById("rngLs").value = state.lsDisplay;
  document.getElementById("rngOpsz").value = state.opsz;
  document.getElementById("rngWght").value = state.customWght;
  document.getElementById("selTheme").value = state.theme;
  document.getElementById("selRenderMode").value = state.renderMode;
  document.getElementById("selNewsOpsz").value = state.newsOpsz;
  document.getElementById("selSrcOpsz").value = state.srcOpsz;
  document.getElementById("selStyleFilter").value = state.styleFilter;
  document.getElementById("selGuides").value = String(state.guides);
  document.getElementById("inpHeadline").value = state.headlineSample;
  fullRender();
});

document.getElementById("btnCopyPrompt").addEventListener("click", async () => {
  const payload = {
    version: "V_001",
    scale_and_geometry: {
      size_display_px: state.sizeDisplay,
      size_specimen_px: state.sizeSpecimen,
      size_lead_px: state.sizeLead,
      size_body_px: state.sizeBody,
      line_height_body: state.lhBody,
      letter_spacing_display_em: state.lsDisplay,
      variable_opsz: state.opsz,
      variable_custom_wght: state.customWght
    },
    display_and_theme: {
      theme: state.theme,
      render_mode: state.renderMode,
      newsreader_optical_cut: state.newsOpsz,
      sourceserif_optical_cut: state.srcOpsz,
      style_filter: state.styleFilter,
      show_metrics_guides: state.guides
    }
  };
  const txt = JSON.stringify(payload, null, 2);
  try {
    await navigator.clipboard.writeText(txt);
    const btn = document.getElementById("btnCopyPrompt");
    const prev = btn.textContent;
    btn.textContent = "Valeurs copiées dans le presse-papiers";
    setTimeout(() => { btn.textContent = prev; }, 1800);
  } catch (err) {
    prompt("Copier ces valeurs HDA :", txt);
  }
});

fullRender();
if (document.fonts && document.fonts.ready) {
  document.fonts.ready.then(() => { measureMetrics(); });
}
</script>
