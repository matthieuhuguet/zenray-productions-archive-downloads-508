<script>
// 12 October 2026 : Etat HDA initial (egal aux valeurs de _params.json)
const DEFAULTS = {"version": "V_001", "created": "12 October 2026", "description": "Planche comparative HDA des 3 familles Serif (Anthropic Serif, Newsreader, Source Serif 4) sur toutes les graisses communes, tailles optiques et axes variables.", "scale_and_geometry": {"size_display_px": 42, "size_specimen_px": 28, "size_lead_px": 21, "size_body_px": 17, "line_height_body": 1.55, "letter_spacing_display_em": -0.015, "variable_opsz": 18, "variable_custom_wght": 350}, "display_and_theme": {"theme": "editorial_light", "render_mode": "static_ttf", "newsreader_optical_cut": "24pt", "sourceserif_optical_cut": "base", "style_filter": "both", "show_metrics_guides": false, "headline_sample": "L'architecture procédurale et la lumière du soir", "body_sample": "Chaque glyphe dessine un équilibre entre le plein du fût, la finesse de la liaison et l'ouverture du contre-poinçon. À taille égale, la hauteur d'x gouverne la lisibilité réelle bien plus que le corps nominal en pixels : 123 456 789,00 €, « Vérité & mesure »."}};

const state = {
  sizeDisplay: DEFAULTS.scale_and_geometry.size_display_px,
  sizeSpecimen: DEFAULTS.scale_and_geometry.size_specimen_px,
  sizeLead: DEFAULTS.scale_and_geometry.size_lead_px,
  sizeBody: DEFAULTS.scale_and_geometry.size_body_px,
  lhBody: DEFAULTS.scale_and_geometry.line_height_body,
  lsDisplay: DEFAULTS.scale_and_geometry.letter_spacing_display_em,
  opsz: DEFAULTS.scale_and_geometry.variable_opsz,
  customWght: DEFAULTS.scale_and_geometry.variable_custom_wght,
  theme: DEFAULTS.display_and_theme.theme,
  renderMode: DEFAULTS.display_and_theme.render_mode,
  newsOpsz: DEFAULTS.display_and_theme.newsreader_optical_cut,
  srcOpsz: DEFAULTS.display_and_theme.sourceserif_optical_cut,
  styleFilter: DEFAULTS.display_and_theme.style_filter,
  guides: DEFAULTS.display_and_theme.show_metrics_guides,
  headlineSample: DEFAULTS.display_and_theme.headline_sample,
  bodySample: DEFAULTS.display_and_theme.body_sample
};

const ALPHABET_SAMPLE = "ABCDEFGHIJKLMNPQRSTUVWXYZ abcdefghijklmnpqrstuvwxyz 0123456789 € $ % & ? ! « » ( )";

const COMMON_WEIGHTS = [
  { weight: 300, name: "Light", isVarOnly: false },
  { weight: 350, name: "Cote ZenRay Éditoriale (Axe Variable)", isVarOnly: true },
  { weight: 400, name: "Regular", isVarOnly: false },
  { weight: 500, name: "Medium", isVarOnly: false },
  { weight: 600, name: "SemiBold", isVarOnly: false },
  { weight: 700, name: "Bold", isVarOnly: false },
  { weight: 800, name: "ExtraBold", isVarOnly: false }
];

const EXTREME_WEIGHTS = [
  { weight: 200, name: "ExtraLight", avail: { anth: false, news: true, src4: true } },
  { weight: 900, name: "Black", avail: { anth: true, news: false, src4: true } }
];

function getFontSpec(famKey, weight, isItalic, forceVar) {
  const useVar = forceVar || state.renderMode === "variable_axis";
  const styleSuffix = isItalic ? "ita" : "rom";
  const styleName = isItalic ? (weight === 400 ? "Italic" : "Italic") : "";
  const wLabel = {
    200: "ExtraLight", 300: "Light", 350: "Var350", 400: "Regular",
    500: "Medium", 600: "SemiBold", 700: "Bold", 800: "ExtraBold", 900: "Black"
  }[weight] || ("W" + weight);

  if (famKey === "anth") {
    if (useVar) {
      const f = isItalic ? "AnthropicSerif-Italics.woff2" : "AnthropicSerif-Romans.woff2";
      return {
        cssFamily: `'zr_anth_var_${styleSuffix}', serif`,
        cssSettings: `"wght" ${weight}`,
        fileLabel: `${f} (wght=${weight})`
      };
    }
    const fileW = isItalic ? (weight === 400 ? "Italic" : wLabel + "Italic") : wLabel;
    return {
      cssFamily: `'zr_anth_${weight}_${styleSuffix}', serif`,
      cssSettings: "normal",
      fileLabel: `AnthropicSerif-${fileW}.ttf`
    };
  }

  if (famKey === "news") {
    if (useVar) {
      const f = isItalic ? "Newsreader-Italic-VariableFont_opsz,wght.ttf" : "Newsreader-VariableFont_opsz,wght.ttf";
      return {
        cssFamily: `'zr_news_var_${styleSuffix}', serif`,
        cssSettings: `"wght" ${weight}, "opsz" ${state.opsz}`,
        fileLabel: `${f} (wght=${weight}, opsz=${state.opsz})`
      };
    }
    const cut = state.newsOpsz;
    const fileW = isItalic ? (weight === 400 ? "Italic" : wLabel + "Italic") : wLabel;
    return {
      cssFamily: `'zr_news_${cut}_${weight}_${styleSuffix}', serif`,
      cssSettings: "normal",
      fileLabel: `Newsreader_${cut}-${fileW}.ttf`
    };
  }

  if (famKey === "src4") {
    if (useVar) {
      const f = isItalic ? "SourceSerif4-Italic-VariableFont_opsz,wght.ttf" : "SourceSerif4-VariableFont_opsz,wght.ttf";
      return {
        cssFamily: `'zr_src4_var_${styleSuffix}', serif`,
        cssSettings: `"wght" ${weight}, "opsz" ${state.opsz}`,
        fileLabel: `${f} (wght=${weight}, opsz=${state.opsz})`
      };
    }
    const cut = state.srcOpsz;
    const prefix = cut === "base" ? "SourceSerif4" : `SourceSerif4_${cut}`;
    const fileW = isItalic ? (weight === 400 ? "Italic" : wLabel + "Italic") : wLabel;
    return {
      cssFamily: `'zr_src4_${cut}_${weight}_${styleSuffix}', serif`,
      cssSettings: "normal",
      fileLabel: `${prefix}-${fileW}.ttf`
    };
  }
}

function buildSpecimenCell(famKey, famTitle, weight, isItalic, forceVar, isAvailable = true) {
  if (!isAvailable) {
    return `<div class="cell-specimen missing">
      <div><strong>${famTitle}</strong> ne possède pas de coupe <span class="num-serif">${weight}</span> ${isItalic ? "Italique" : "Romain"}.</div>
    </div>`;
  }
  const spec = getFontSpec(famKey, weight, isItalic, forceVar);
  const fStyle = isItalic ? "italic" : "normal";
  const fvs = spec.cssSettings !== "normal" ? `font-variation-settings: ${spec.cssSettings};` : "";
  return `<div class="cell-specimen">
    <div class="cell-top-meta">
      <span>${famTitle} · ${weight}${isItalic ? "i" : ""}</span>
      <span>${spec.fileLabel}</span>
    </div>
    <div class="spec-headline" contenteditable="true" spellcheck="false"
         style="font-family: ${spec.cssFamily}; font-style: ${fStyle}; ${fvs}">${escapeHtml(state.headlineSample)}</div>
    <div class="spec-alphabet"
         style="font-family: ${spec.cssFamily}; font-style: ${fStyle}; ${fvs}">${escapeHtml(ALPHABET_SAMPLE)}</div>
    <div class="spec-body" contenteditable="true" spellcheck="false"
         style="font-family: ${spec.cssFamily}; font-style: ${fStyle}; ${fvs}">${escapeHtml(state.bodySample)}</div>
  </div>`;
}

function escapeHtml(str) {
  return String(str)
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;");
}

function renderEditorialCards() {
  const container = document.getElementById("editorialGrid");
  const w = state.customWght;
  document.getElementById("lblEdWght").textContent = w;

  const families = [
    { key: "anth", label: "Anthropic Serif", note: "Référence système ZenRay" },
    { key: "news", label: "Newsreader", note: `Production Type · opsz ${state.opsz}pt` },
    { key: "src4", label: "Source Serif 4", note: `Adobe · opsz ${state.opsz}pt` }
  ];

  container.innerHTML = families.map(f => {
    // Clamp weight to supported variable range for each family
    const clampedW = f.key === "anth" ? Math.max(300, Math.min(900, w))
                   : f.key === "news" ? Math.max(200, Math.min(800, w))
                   : Math.max(200, Math.min(900, w));
    const rom = getFontSpec(f.key, clampedW, false, true);
    const ita = getFontSpec(f.key, clampedW, true, true);
    const numSpec = getFontSpec(f.key, 400, false, false);

    return `<article class="editorial-card">
      <div class="ed-kicker">${f.label} · wght ${clampedW} (${f.note})</div>
      <h3 class="ed-h1" contenteditable="true" spellcheck="false"
          style="font-family: ${rom.cssFamily}; font-variation-settings: ${rom.cssSettings};">${escapeHtml(state.headlineSample)}</h3>
      <p class="ed-lead" contenteditable="true" spellcheck="false"
         style="font-family: ${rom.cssFamily}; font-variation-settings: ${rom.cssSettings};">
        Un système paramétrique sépare la définition de ses valeurs : un seul réglage propage le dessin sur toute l'interface.
      </p>
      <p class="ed-body" contenteditable="true" spellcheck="false"
         style="font-family: ${rom.cssFamily}; font-variation-settings: ${rom.cssSettings};">${escapeHtml(state.bodySample)}</p>
      <blockquote class="ed-quote" contenteditable="true" spellcheck="false"
                  style="font-family: ${ita.cssFamily}; font-style: italic; font-variation-settings: ${ita.cssSettings};">
        « L'italique révèle la véritable personnalité calligraphique d'une police à empattements, son rythme et sa tension. »
      </blockquote>
      <div class="ed-kpi-row">
        <div>
          <div class="ed-kpi-num" style="font-family: ${numSpec.cssFamily};">20 000 €</div>
          <div class="ed-kpi-label">Cap autonome (400)</div>
        </div>
        <div>
          <div class="ed-kpi-num" style="font-family: ${numSpec.cssFamily};">138 TTF</div>
          <div class="ed-kpi-label">Coupes installées</div>
        </div>
        <div>
          <div class="ed-kpi-num" style="font-family: ${numSpec.cssFamily};">2026·10·12</div>
          <div class="ed-kpi-label">Chiffres tabulaires</div>
        </div>
      </div>
    </article>`;
  }).join("");
}

function renderWeightsSection() {
  const commonEl = document.getElementById("commonWeightsContainer");
  const extremeEl = document.getElementById("extremeWeightsContainer");

  const stylesToRender = state.styleFilter === "roman" ? [false]
                       : state.styleFilter === "italic" ? [true]
                       : [false, true];

  let commonHtml = "";
  for (const item of COMMON_WEIGHTS) {
    const w = item.weight === 350 ? state.customWght : item.weight;
    const isHighlight = item.isVarOnly;
    for (const isItalic of stylesToRender) {
      const styleTag = isItalic ? "Italique" : "Romain";
      const badgeLabel = item.isVarOnly ? `${w}${isItalic ? "i" : ""} var` : `${w}${isItalic ? "i" : ""}`;
      const titleLabel = item.isVarOnly
        ? `Graisse Variable Libre (défaut ZenRay 350, actuel : ${w}) · ${styleTag}`
        : `${item.name} (${w}) · ${styleTag}`;

      commonHtml += `<div class="weight-band ${isHighlight ? "highlight-350" : ""}">
        <div class="weight-band-header">
          <div class="weight-title">
            <span class="weight-num">${badgeLabel}</span>
            <span class="weight-name">${titleLabel}</span>
          </div>
          <span class="weight-status">${item.isVarOnly || state.renderMode === "variable_axis" ? "Axe Variable (wght + opsz)" : "Fichiers TTF Statiques dédiés"}</span>
        </div>
        <div class="tri-grid">
          ${buildSpecimenCell("anth", "Anthropic Serif", Math.max(300, Math.min(900, w)), isItalic, item.isVarOnly, true)}
          ${buildSpecimenCell("news", "Newsreader", Math.max(200, Math.min(800, w)), isItalic, item.isVarOnly, true)}
          ${buildSpecimenCell("src4", "Source Serif 4", Math.max(200, Math.min(900, w)), isItalic, item.isVarOnly, true)}
        </div>
      </div>`;
    }
  }
  commonEl.innerHTML = commonHtml;

  let extremeHtml = "";
  for (const item of EXTREME_WEIGHTS) {
    for (const isItalic of stylesToRender) {
      const styleTag = isItalic ? "Italique" : "Romain";
      extremeHtml += `<div class="weight-band">
        <div class="weight-band-header">
          <div class="weight-title">
            <span class="weight-num">${item.weight}${isItalic ? "i" : ""}</span>
            <span class="weight-name">${item.name} (${item.weight}) · ${styleTag}</span>
          </div>
          <span class="weight-status">Hors-intersection complète (2 familles sur 3)</span>
        </div>
        <div class="tri-grid">
          ${buildSpecimenCell("anth", "Anthropic Serif", item.weight, isItalic, false, item.avail.anth)}
          ${buildSpecimenCell("news", "Newsreader", item.weight, isItalic, false, item.avail.news)}
          ${buildSpecimenCell("src4", "Source Serif 4", item.weight, isItalic, false, item.avail.src4)}
        </div>
      </div>`;
    }
  }
  extremeEl.innerHTML = extremeHtml;
}

