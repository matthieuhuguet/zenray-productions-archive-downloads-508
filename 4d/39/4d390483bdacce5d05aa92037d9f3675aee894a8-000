  :root {
    /* 12 October 2026 : Parametres HDA Categorie 1 : Echelle et Geometrie (8 max) */
    --hda-size-display: 42px;
    --hda-size-specimen: 28px;
    --hda-size-lead: 21px;
    --hda-size-body: 17px;
    --hda-lh-body: 1.55;
    --hda-ls-display: -0.015em;
    --hda-opsz: 18;
    --hda-custom-wght: 350;

    /* 12 October 2026 : Jetons de theme (pilotes par Categorie 2) */
    --bg-page: #FAF8F5;
    --bg-card: #FFFFFF;
    --bg-subtle: #F2EFE9;
    --bg-badge: #EAE5DC;
    --text-main: #181715;
    --text-muted: #68645E;
    --text-faint: #969188;
    --border-color: #E2DDD3;
    --accent: #B85A28;
    --accent-soft: rgba(184, 90, 40, 0.10);
    --guide-line: rgba(184, 90, 40, 0.35);
  }

  body[data-theme="pure_white"] {
    --bg-page: #FFFFFF;
    --bg-card: #FAFAFA;
    --bg-subtle: #F3F3F3;
    --bg-badge: #E8E8E8;
    --text-main: #111111;
    --text-muted: #5E5E5E;
    --text-faint: #8E8E8E;
    --border-color: #E4E4E4;
  }

  body[data-theme="dark_obsidian"] {
    --bg-page: #111110;
    --bg-card: #181816;
    --bg-subtle: #20201D;
    --bg-badge: #2A2A26;
    --text-main: #F2EFE9;
    --text-muted: #A39E95;
    --text-faint: #6E6A63;
    --border-color: #2B2A27;
    --accent: #E07A47;
    --accent-soft: rgba(224, 122, 71, 0.14);
    --guide-line: rgba(224, 122, 71, 0.40);
  }

  body[data-theme="warm_ink"] {
    --bg-page: #191614;
    --bg-card: #221E1B;
    --bg-subtle: #2B2622;
    --bg-badge: #36302B;
    --text-main: #EFE8DE;
    --text-muted: #B0A598;
    --text-faint: #7D7368;
    --border-color: #352F2A;
    --accent: #DFA06B;
    --accent-soft: rgba(223, 160, 107, 0.14);
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    padding: 0;
    background: var(--bg-page);
    color: var(--text-main);
    font-family: var(--font-sans);
    font-weight: 400;
    -webkit-font-smoothing: antialiased;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .num-serif {
    font-family: 'zr_anth_400_rom', serif;
    font-weight: 400;
    font-variant-numeric: tabular-nums;
  }

  /* Barre d'atelier HDA collante en haut */
  .hda-panel {
    position: sticky;
    top: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--bg-card) 92%, transparent);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border-color);
    padding: 14px 28px;
  }

  .hda-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 12px;
  }

  .hda-title-group {
    display: flex;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
  }

  .hda-badge {
    font-family: var(--font-mono);
    font-size: 11px;
    padding: 3px 8px;
    border-radius: 6px;
    background: var(--accent-soft);
    color: var(--accent);
    border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
  }

  .hda-title {
    font-family: 'zr_anth_var_rom', serif;
    font-variation-settings: "wght" 350;
    font-size: 20px;
    margin: 0;
  }

  .hda-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  button.hda-btn {
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: 12px;
    padding: 6px 12px;
    border-radius: 8px;
    border: 1px solid var(--border-color);
    background: var(--bg-subtle);
    color: var(--text-main);
    cursor: pointer;
    transition: all 0.12s ease;
  }

  button.hda-btn:hover {
    border-color: var(--accent);
  }

  button.hda-btn.primary {
    background: var(--accent);
    color: #FFFFFF;
    border-color: var(--accent);
  }

  .hda-controls-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(185px, 1fr));
    gap: 10px 16px;
    align-items: end;
  }

  .hda-Details-closed .hda-controls-body {
    display: none;
  }

  .ctrl-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .ctrl-label {
    display: flex;
    justify-content: space-between;
    font-size: 11px;
    color: var(--text-muted);
  }

  .ctrl-val {
    font-family: 'zr_anth_400_rom', serif;
    color: var(--text-main);
    font-weight: 400;
  }

  input[type="range"] {
    width: 100%;
    accent-color: var(--accent);
    height: 4px;
    cursor: pointer;
  }

  select.hda-select, input.hda-text {
    font-family: var(--font-sans);
    font-size: 12px;
    padding: 5px 8px;
    border-radius: 6px;
    border: 1px solid var(--border-color);
    background: var(--bg-page);
    color: var(--text-main);
    width: 100%;
  }

  /* Conteneur principal pleine largeur haute resolution */
  .sheet-container {
    max-width: 1840px;
    margin: 0 auto;
    padding: 28px 28px 96px;
  }

  .section-block {
    margin-bottom: 48px;
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 10px;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }

  .section-title {
    font-family: 'zr_anth_var_rom', serif;
    font-variation-settings: "wght" 350;
    font-size: 24px;
    margin: 0;
  }

  .section-sub {
    font-size: 13px;
    color: var(--text-muted);
  }

  /* Grille 3 colonnes pour les 3 familles */
  .tri-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  .col-header-sticky {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    margin-bottom: 14px;
  }

  .fam-header-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 16px 20px;
  }

  .fam-title-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 6px;
  }

  .fam-name {
    font-size: 16px;
    font-weight: 400;
    color: var(--text-main);
  }

  .fam-tag {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-muted);
    background: var(--bg-subtle);
    padding: 2px 8px;
    border-radius: 99px;
  }

  .fam-specs {
    font-size: 12px;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .metrics-bar {
    margin-top: 10px;
    padding-top: 10px;
    border-top: 1px dashed var(--border-color);
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    font-size: 12px;
    color: var(--text-muted);
  }

  .metrics-bar strong {
    font-family: 'zr_anth_400_rom', serif;
    font-weight: 400;
    color: var(--text-main);
  }

  /* Lignes de comparaison de graisse */
  .weight-band {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 14px;
    padding: 18px 20px;
    margin-bottom: 14px;
  }

  .weight-band.highlight-350 {
    border-color: var(--accent);
    box-shadow: 0 0 0 1px var(--accent-soft);
  }

  .weight-band-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 14px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--bg-subtle);
    flex-wrap: wrap;
  }

  .weight-title {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .weight-num {
    font-family: 'zr_anth_400_rom', serif;
    font-size: 18px;
    padding: 2px 10px;
    border-radius: 6px;
    background: var(--bg-badge);
    color: var(--text-main);
  }

  .weight-name {
    font-size: 14px;
    color: var(--text-main);
  }

  .weight-status {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-muted);
  }

  .cell-specimen {
    padding: 12px 14px;
    border-radius: 10px;
    background: var(--bg-page);
    border: 1px solid var(--border-color);
    display: flex;
    flex-direction: column;
    gap: 8px;
    overflow: hidden;
  }

  .cell-specimen.missing {
    opacity: 0.45;
    background: var(--bg-subtle);
    justify-content: center;
    align-items: center;
    min-height: 120px;
    font-size: 12px;
    color: var(--text-muted);
    text-align: center;
  }

  .cell-top-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--text-faint);
  }

  .spec-headline {
    font-size: var(--hda-size-specimen);
    line-height: 1.2;
    letter-spacing: var(--hda-ls-display);
    margin: 2px 0;
    word-break: break-word;
    position: relative;
  }

  body[data-guides="true"] .spec-headline {
    background-image:
      linear-gradient(to bottom, transparent calc(50% - 0.5px), var(--guide-line) calc(50% - 0.5px), var(--guide-line) calc(50% + 0.5px), transparent calc(50% + 0.5px)),
      linear-gradient(to bottom, transparent calc(82% - 0.5px), var(--guide-line) calc(82% - 0.5px), var(--guide-line) calc(82% + 0.5px), transparent calc(82% + 0.5px));
  }

  .spec-alphabet {
    font-size: 14px;
    line-height: 1.35;
    color: var(--text-muted);
    letter-spacing: 0.01em;
  }

  .spec-body {
    font-size: var(--hda-size-body);
    line-height: var(--hda-lh-body);
    color: var(--text-main);
    margin-top: 2px;
  }

  /* Tableau recapitulatif des graisses disponibles */
  .matrix-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    overflow: hidden;
  }

  .matrix-table th, .matrix-table td {
    padding: 10px 14px;
    text-align: left;
    border-bottom: 1px solid var(--border-color);
  }

  .matrix-table th {
    background: var(--bg-subtle);
    color: var(--text-muted);
    font-weight: 400;
    font-size: 12px;
  }

  .pill-ok {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 99px;
    font-size: 11px;
    background: rgba(46, 133, 85, 0.14);
    color: #2E8555;
    font-family: var(--font-mono);
  }

  body[data-theme="dark_obsidian"] .pill-ok,
  body[data-theme="warm_ink"] .pill-ok {
    color: #68D391;
  }

  .pill-var {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 99px;
    font-size: 11px;
    background: var(--accent-soft);
    color: var(--accent);
    font-family: var(--font-mono);
  }

  .pill-no {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 99px;
    font-size: 11px;
    background: var(--bg-subtle);
    color: var(--text-faint);
    font-family: var(--font-mono);
  }

  /* Banc d'essai editorial */
  .editorial-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 14px;
    padding: 24px;
  }

  .ed-kicker {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    margin-bottom: 8px;
  }

  .ed-h1 {
    font-size: var(--hda-size-display);
    line-height: 1.12;
    letter-spacing: var(--hda-ls-display);
    margin: 0 0 14px 0;
  }

  .ed-lead {
    font-size: var(--hda-size-lead);
    line-height: 1.42;
    color: var(--text-muted);
    margin: 0 0 18px 0;
  }

  .ed-body {
    font-size: var(--hda-size-body);
    line-height: var(--hda-lh-body);
    margin: 0 0 16px 0;
  }

  .ed-quote {
    margin: 16px 0;
    padding: 10px 16px;
    border-left: 2px solid var(--accent);
    font-size: calc(var(--hda-size-body) * 1.08);
    line-height: 1.48;
    color: var(--text-muted);
  }

  .ed-kpi-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    padding-top: 14px;
    border-top: 1px solid var(--border-color);
  }

  .ed-kpi-num {
    font-size: 26px;
    line-height: 1.1;
  }

  .ed-kpi-label {
    font-family: var(--font-sans);
    font-size: 11px;
    color: var(--text-muted);
    margin-top: 3px;
  }

  @media (max-width: 1100px) {
    .tri-grid, .col-header-sticky {
      grid-template-columns: 1fr;
    }
  }
</style>
